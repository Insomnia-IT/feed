{
    "name": "@feed/admin",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:stage": "vite --mode stage",
        "build": "npm run typecheck && vite build",
        "lint": "npm run lint:code && npm run lint:styles",
        "lint:fix": "npm run lint:code:fix && npm run lint:styles:fix",
        "lint:code": "oxlint src --report-unused-disable-directives",
        "lint:code:fix": "oxlint src --report-unused-disable-directives --fix",
        "lint:styles": "stylelint ./src/**/*.css",
        "lint:styles:fix": "stylelint --fix ./src/**/*.css",
        "typecheck": "tsc -b",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@ant-design/icons": "^6.3.4",
        "@feed/shared": "*",
        "@refinedev/antd": "^6.0.3",
        "@refinedev/core": "^5.0.12",
        "@refinedev/react-router": "^2.0.4",
        "@tanstack/react-query": "^5.102.8",
        "antd": "^5.29.3",
        "axios": "^1.20.0",
        "classnames": "^2.5.1",
        "dayjs": "^1.11.23",
        "onscan.js": "^1.5.2",
        "qr-scanner": "^1.4.2",
        "quill": "^2.0.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^7.18.3",
        "recharts": "^3.10.1",
        "ulid": "^3.0.2"
    },
    "devDependencies": {
        "@types/onscan.js": "^1.5.6",
        "jsdom": "^30.0.1",
        "vitest": "^4.1.11"
    }
}
