{
    "name": "feed",
    "version": "1.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": "^22.22.1 || >=24.0.0"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "bootstrap": "npm ci",
        "dev:admin": "npm --workspace @feed/admin run dev",
        "dev:scanner": "npm --workspace @feed/scanner run dev",
        "dev": "node scripts/run-npm-parallel.mjs dev:admin dev:scanner",
        "build": "npm run build:admin && npm run build:scanner",
        "build:admin": "npm --workspace @feed/admin run build",
        "build:scanner": "npm --workspace @feed/scanner run build",
        "preview:admin": "npm --workspace @feed/admin run preview",
        "preview:scanner": "npm --workspace @feed/scanner run preview",
        "typecheck": "tsc -b",
        "typecheck:watch": "tsc -b -w",
        "lint:code": "oxlint packages --report-unused-disable-directives",
        "lint:code:fix": "oxlint packages --report-unused-disable-directives --fix",
        "lint:styles": "stylelint \"packages/**/*.{css,scss,less}\"",
        "lint:styles:fix": "stylelint --fix \"packages/**/*.{css,scss,less}\"",
        "format": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,css,scss,less,md}\"",
        "format:write": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css,scss,less,md}\"",
        "lint": "npm run lint:code && npm run lint:styles && npm run format && npm run typecheck",
        "lint:fix": "npm run lint:code:fix && npm run lint:styles:fix && npm run format:write",
        "madge": "npx madge packages",
        "stat": "tokei",
        "prepare": "husky"
    },
    "devDependencies": {
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.6",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "husky": "^9.1.7",
        "oxlint": "^1.81.0",
        "prettier": "^3.9.6",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vite-plugin-pwa": "^1.3.0"
    }
}
